{
    "name": "moonshine/multi-panels",
    "description": "Multi panels for MoonShine",
    "keywords": ["moonshine", "multi-panels", "multi-tenant", "tenancy"],
    "type": "library",
    "homepage": "https://getmoonshine.app",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/moonshine-software/multi-panels/issues",
        "source": "https://github.com/moonshine-software/multi-panels"
    },
    "authors": [
        {
            "name": "Danil Shutsky",
            "email": "thecutcode@gmail.com",
            "homepage": "https://cutcode.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "moonshine/moonshine": "5.x-dev",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "MoonShine\\MultiPanels\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MoonShine\\MultiPanels\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "conflict": {
        "moonshine/moonshine": "<4.4 || >=6.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "MoonShine\\MultiPanels\\Providers\\MultiPanelServiceProvider"
            ]
        }
    }
}
